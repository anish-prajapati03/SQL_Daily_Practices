-- Inner join
-- ** using an INNER JOIN between: employees, departments
Select e.fname,
	   d.dept_name
	From employees e
    INNER JOIN department d
    on e.dept_id = d.dept_id;
   
-- 1) Display the employee's first name, salary, and department manager using an INNER JOIN.
select e.first_name , e.salary,d.department_name, d.manager from employees e
INNER JOIN departments d
ON e.department = d.department_name;

-- 2) Display the first_name, department, and manager of employees who work in the IT department.
Select  e.first_name , e.department , d.manager from employees e
INNER JOIN departments d
ON e.department = d.department_name  
where e.department = 'IT';

-- 3) Display the first_name, salary, department, and manager of employees whose salary is greater than 55,000.
Select e.first_name,e.salary, e.department , d.manager from employees e
INNER JOIN departments d
ON e.department =d.department_name
where e.salary > 55000 ;

-- 4) Display the employee first_name, department, manager, and salary, and sort the employees by salary from highest to lowest.
Select e.first_name,e.salary, e.department , d.manager from employees e
INNER JOIN departments d
ON e.department =d.department_name
order by e.salary DESC ;


