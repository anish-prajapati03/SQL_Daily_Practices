-- Right Join
-- ** Display all departments, including those that have no employees.
select e.first_name, d.department_name
	from employees e 
RIGHT JOIN department d
on d.dept_id = d.dept_id;

-- Display all departments and their employees using RIGHT JOIN.
Select d.department_name, e.first_name from departments d
RIGHT JOIN employees e
ON d.department_name = e.department;

