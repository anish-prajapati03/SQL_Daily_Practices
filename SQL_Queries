-- Having and DISTINCT 

-- Find departments having more than 1 employee.
Select department, count(*) from employees
group by department
having count(*)>1 ;

-- Find departments where the average salary is greater than 55,000.
Select department, AVG(salary) from employees
group by department
having AVG(salary) > 55000 ; 

-- Find departments where the total salary is greater than 100,000.
Select department, SUM(salary) from employees
group by department
having SUM(salary) > 100000 ; 

-- Find departments having at least 2 employees, and sort them by employee count from highest to lowest.
select department ,count(*) from employees 
group by department 
having count(*)>=2 
order by count(*) desc ; 

